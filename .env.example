# ==============================================================================
# Plane Self-Hosted Deployment Configuration Template
# Release: v1.5.0 (Community Edition)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    Windows PowerShell: Copy-Item .env.example .env
#    Linux / macOS:      cp .env.example .env
# 2. Automatically generate secure random secrets:
#    python scripts/generate_secrets.py
# 3. Configure your domain (APP_DOMAIN and WEB_URL) and exposed ports.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Routing Settings
# ------------------------------------------------------------------------------
# Pinned application release tag matching official MakePlane releases
APP_RELEASE=v1.5.0

# Base domain or IP address of your server (e.g. plane.yourcompany.com or 192.168.1.100 or localhost)
APP_DOMAIN=localhost

# Full web URL used by the frontend and API for redirects and asset resolution
WEB_URL=http://localhost

# Allowed CORS origins (must match WEB_URL or include your domain scheme)
CORS_ALLOWED_ORIGINS=http://localhost

# Internal API endpoint URL for inter-container communication
API_BASE_URL=http://api:8000

# Host port mappings for the built-in Caddy reverse proxy
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# Bundled Caddy proxy site address. Use ":80" for HTTP, or your domain for auto-HTTPS
SITE_ADDRESS=:80

# Trusted reverse proxies for client IP forwarding (e.g. "0.0.0.0/0" or CIDRs)
TRUSTED_PROXIES=0.0.0.0/0

# Optional ACME SSL configuration for automatic Let's Encrypt certificates
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_EMAIL=
CERT_ACME_DNS=

# Number of reverse proxies upstream of Plane proxy (set to 1 if behind Nginx/Cloudflare)
NUM_PROXIES=

# ------------------------------------------------------------------------------
# 2. Application Security Keys (DO NOT COMMIT SENSITIVE VALUES TO GIT)
# ------------------------------------------------------------------------------
# Django cryptographic secret key (minimum 50 random alphanumeric/symbols)
# Generate with: python scripts/generate_secrets.py
SECRET_KEY=change-this-to-a-secure-random-50-character-secret-key

# Live collaboration WebSocket server secret key (minimum 32 random hex characters)
LIVE_SERVER_SECRET_KEY=change-this-to-a-secure-random-32-char-live-key

# Debug mode: 0 for Production (Strict security), 1 for Local Debugging
DEBUG=0

# ------------------------------------------------------------------------------
# 3. Database Settings (PostgreSQL 15.7)
# ------------------------------------------------------------------------------
PGHOST=plane-db
POSTGRES_PORT=5432
POSTGRES_DB=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane_db_password_change_me
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:plane_db_password_change_me@plane-db:5432/plane

# ------------------------------------------------------------------------------
# 4. In-Memory Cache & Pub/Sub (Valkey / Redis 7.2)
# ------------------------------------------------------------------------------
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/
REDIS_SSL_CERT_REQS=required
REDIS_SSL_CA_CERTS=

# ------------------------------------------------------------------------------
# 5. Asynchronous Message Broker (RabbitMQ 3.13)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane_mq_password_change_me
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:plane_mq_password_change_me@plane-mq:5672/plane

# ------------------------------------------------------------------------------
# 6. Object Storage / File Uploads (Bundled MinIO / Silo or External S3)
# ------------------------------------------------------------------------------
# 1 = use bundled MinIO service; 0 = use external AWS S3 or Cloudflare R2
USE_MINIO=1

AWS_REGION=
AWS_ACCESS_KEY_ID=plane_storage_access_key
AWS_SECRET_ACCESS_KEY=plane_storage_secret_key_change_me
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads

# Maximum allowed file upload size in bytes (52428800 = 50 MB)
FILE_SIZE_LIMIT=52428800

# Set to 1 if using an SSL-enabled MinIO or S3 endpoint
MINIO_ENDPOINT_SSL=0

# ------------------------------------------------------------------------------
# 7. Service Replicas & Concurrency
# ------------------------------------------------------------------------------
WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1
GUNICORN_WORKERS=2

# ------------------------------------------------------------------------------
# 8. Rate Limiting & Security Controls
# ------------------------------------------------------------------------------
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute

# Webhook allowed internal IP / Host filters (comma-separated CIDRs)
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# ------------------------------------------------------------------------------
# 9. Email / SMTP Configuration (Optional, for invitations and notifications)
# ------------------------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=notifications@yourdomain.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_FROM=notifications@yourdomain.com
